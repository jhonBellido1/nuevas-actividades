// 1) Crear una clase Persona con los atributos de su preferencia.

class Persona {
  String nombre;
  String apellido;
  int edad;
  String profesion;

  // 2) Crear un constructor que reciba dichos  atributos.

  Persona({
    required this.nombre,
    required this.apellido,
    required this.edad,
    this.profesion = 'ninguna',
  });

  
  // 3) Crear un constructor por nombre personalizado que reciba datos en forma JSON.
 
  Persona.fromJson(Map<String, dynamic> json)
      : nombre = json['nombre'] ?? 'nombre no encontrado',
        apellido = json['apellido'] ?? 'apellido no encontrado',
        edad = json['edad'] ?? 0,
        profesion = json['profesion'] ?? 'sin profesión';


  // 4) Imprimir en consola haciendo uso de interpolación de string.
  
  @override
  String toString() {
    return 'Persona: $nombre $apellido, ${edad} años, profesión: $profesion';
    
  }
}


